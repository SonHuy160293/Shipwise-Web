# Public browser configuration. NEVER put secrets here.
VITE_API_BASE_URL=/api
# Vite forwards /api to the local Gateway at http://127.0.0.1:19090.
# For a direct deployment URL, include the /api prefix (https://host/api).
# Used only by the Node contract-generation script, not exposed to Vite.
# Run with OPENAPI_SPEC set in your shell; the generator does not load .env files.
# OPENAPI_SPEC=../Shipwise/contracts/openapi/shipwise.v1.json
